# Copy these NAMES to Vercel's Environment Variables settings.
# Never commit real keys or database URLs. Only the first two variables are public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
RESEND_API_KEY=
NIDOR_RECEIPT_FROM=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
# Optional: exact comma-separated origins; no paths or wildcard domains.
CORS_ALLOWED_ORIGINS=
